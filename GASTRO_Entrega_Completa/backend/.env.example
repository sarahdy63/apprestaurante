# Puerto HTTP donde se ejecutará la API.
PORT=3000
# Host de MySQL. En instalación local normalmente es localhost.
DB_HOST=localhost
# Puerto estándar de MySQL.
DB_PORT=3306
# Usuario de MySQL.
DB_USER=root
# Contraseña de MySQL. Cambia este valor por la tuya.
DB_PASSWORD=TU_CLAVE_MYSQL
# Nombre de la base de datos creada con database.sql.
DB_NAME=gastro_db
# Clave privada usada para firmar los JWT. Cámbiala en ambientes reales.
JWT_SECRET=cambiar_esta_clave_por_una_muy_larga_y_segura
# Tiempo de vida del token de administrador.
JWT_EXPIRES_IN=8h
# Origen permitido para el frontend local.
CORS_ORIGIN=http://127.0.0.1:5500,http://localhost:5500
# Credenciales iniciales; se crean automáticamente si no existe un administrador.
ADMIN_EMAIL=admin@gastro.com
ADMIN_PASSWORD=123456
